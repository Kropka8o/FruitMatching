<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="2"
        android:rowCount="5"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

<!--        Score-->
        <LinearLayout
            android:layout_row="0"
            android:layout_column="0">

            <TextView
                android:id="@+id/scoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: "
                android:textSize="24sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/scoreNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@id/scoreLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/plate_one_container"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp" >
            <GridLayout
                android:id="@+id/plate_one"
                android:background="@drawable/ddffdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/plate_two_container"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp" >
            <GridLayout
                android:id="@+id/plate_two"
                android:background="@drawable/ddffdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/plate_three_container"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp" >
            <GridLayout
                android:id="@+id/plate_three"
                android:background="@drawable/ddffdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/plate_four_container"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp" >
            <GridLayout
                android:id="@+id/plate_four"
                android:background="@drawable/ddffdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/plate_five_container"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp" >
            <GridLayout
                android:id="@+id/plate_five"
                android:background="@drawable/ddffdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/plate_six_container"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp" >
            <GridLayout
                android:id="@+id/plate_six"
                android:background="@drawable/ddffdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/fruit_container"
            android:layout_row="4"
            android:layout_columnSpan="2"
            android:orientation="horizontal" >

<!--            <ImageView-->
<!--                android:id="@+id/iv_fruit_one"-->
<!--                android:layout_width="50dp"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_gravity="center"-->
<!--                android:layout_margin="10dp" />-->

<!--            <ImageView-->
<!--                android:id="@+id/iv_fruit_two"-->
<!--                android:layout_width="50dp"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_gravity="center"-->
<!--                android:layout_margin="10dp" />-->

<!--            <ImageView-->
<!--                android:id="@+id/iv_fruit_three"-->
<!--                android:layout_width="50dp"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_gravity="center"-->
<!--                android:layout_margin="10dp" />-->

